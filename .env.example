# 微信云托管 MySQL（仅放云托管环境变量，不要提交真实密码）
MYSQL_ADDRESS=10.x.x.x:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=healtools
MYSQL_POOL_LIMIT=8
AUTO_MIGRATE=1

# 微信云托管对象存储中的公共音频根地址
HEALTOOLS_AUDIO_BASE_URL=https://your-audio-domain/healtools/audio/v0.4.0

# CloudBase AI+（推荐：环境级 API Key + OpenAI-compatible HTTP API）
# 注意：这是“腾讯云 CloudBase AI 环境”，不是微信云托管 prod 环境 ID。
CLOUDBASE_AI_ENV_ID=your-cloudbase-ai-env-id
CLOUDBASE_AI_API_KEY=CHANGE_ME
CLOUDBASE_AI_MODEL=hy3
CLOUDBASE_AI_TIMEOUT_MS=12000
HEALTOOLS_AI_ENABLED=1

# 可选：私有数据导出到 CloudBase 存储。暂不配置时，/data-export 直接返回 JSON。
# 和 AI 环境分开，避免把用户导出文件误存到 AI 环境。
CLOUDBASE_EXPORT_ENV_ID=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# 管理面板（/admin）
HEALTOOLS_ADMIN_USER=admin
HEALTOOLS_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM

# 仅本地开发可用；生产环境不要开启
ALLOW_DEV_OPENID=0
